{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seahawks.nfl-it.lab/schemas/report-1.0.json",
  "title": "Rapport Seahawks Harvester",
  "description": "Contrat d'échange Harvester -> Nester, version 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "generated_at", "probe", "scan", "wan_latency"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "report_id": { "type": "string", "format": "uuid" },
    "generated_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "hostname", "ip", "version"],
      "properties": {
        "probe_id": { "type": "string", "pattern": "^[a-z0-9-]{3,64}$" },
        "hostname": { "type": "string", "minLength": 1, "maxLength": 253 },
        "ip": { "type": "string", "format": "ipv4" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "status", "started_at", "duration_s", "hosts_found", "hosts"],
      "properties": {
        "network": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$" },
        "status": { "enum": ["success", "partial", "failed"] },
        "started_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "duration_s": { "type": "number", "minimum": 0 },
        "hosts_found": { "type": "integer", "minimum": 0 },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ip", "hostname", "open_ports"],
            "properties": {
              "ip": { "type": "string", "format": "ipv4" },
              "hostname": { "type": ["string", "null"] },
              "open_ports": {
                "type": "array",
                "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "uniqueItems": true
              }
            }
          }
        },
        "error": { "type": ["string", "null"] }
      }
    },
    "wan_latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "samples", "avg_ms", "min_ms", "max_ms", "loss_pct"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "samples": { "type": "integer", "minimum": 1 },
        "avg_ms": { "type": ["number", "null"], "minimum": 0 },
        "min_ms": { "type": ["number", "null"], "minimum": 0 },
        "max_ms": { "type": ["number", "null"], "minimum": 0 },
        "loss_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
